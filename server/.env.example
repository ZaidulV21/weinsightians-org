# ==========================================
# SERVER ENVIRONMENT
# ==========================================
# Copy to .env and fill in real values. Never commit the filled-in file.
# On Render these are set in the service's Environment settings instead, and
# server/.env is not used at all.
#
# This file holds SERVER values only. Anything prefixed VITE_ belongs to the
# React app in the repository root, not here.

# Server Configuration
PORT=6200

# Environment: development | production | test
# production turns on Secure cookies and hides internal error detail.
NODE_ENV=development

# Database
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/blogs

# JWT Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters in production; the server refuses to start otherwise.
JWT_SECRET=replace-with-a-long-random-string
# Accepts 30m, 8h, 1d, 7d. Keep the cookie lifetime in step with this value.
JWT_EXPIRES_IN=8h

# Cloudinary (blog images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS allowlist. The production frontend is built in, so this is only needed
# for extra origins such as a preview deployment. Comma separated, no trailing slash.
# FRONTEND_URL=https://weinsightian.tech
# ALLOWED_ORIGINS=https://preview.weinsightian.tech

# Set to "true" to disable rate limiting. Only useful while debugging locally.
# RATE_LIMIT_DISABLED=false
